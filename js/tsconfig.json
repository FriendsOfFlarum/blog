{
  "extends": "flarum-tsconfig",
  "include": [
    "src/**/*",
    "../vendor/flarum/core/js/dist-typings/@types/**/*"
  ],
  "compilerOptions": {
    "declarationDir": "./dist-typings",
    "baseUrl": ".",
    "paths": {
      "flarum/tags/components/*": [
        "../vendor/flarum/tags/js/dist-typings/forum/components/*"
      ],
      "flarum/tags/*": [
        "../vendor/flarum/tags/js/dist-typings/*"
      ],
      "flarum/*": [
        "../vendor/flarum/core/js/dist-typings/*"
      ],
      "@flarum/core/forum": [
        "../vendor/flarum/core/js/dist-typings/forum/index"
      ],
      "@fof/discussion-language/*": [
        "../vendor/fof/discussion-language/js/dist-typings/*"
      ],
      "ext:flarum/tags": [
        "../vendor/flarum/tags/js/dist-typings/*"
      ]
    }
  }
}