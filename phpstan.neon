includes:
  - vendor/flarum/phpstan/extension.neon

parameters:
  level: 6
  paths:
    - extend.php
    - src
    - vendor/flarum/tags/extend.php
  excludePaths:
    analyse:
      - *.blade.php
      - vendor/flarum/tags/extend.php
  checkMissingIterableValueType: false
  databaseMigrationsPath: ['migrations']
